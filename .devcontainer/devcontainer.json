{
  "name": "AI Trading Agent + IBKR Paper",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "11"
    }
  },
  "forwardPorts": [5000, 6080],
  "portsAttributes": {
    "5000": {
      "label": "IBKR Paper Client Portal",
      "protocol": "https",
      "onAutoForward": "notify"
    },
    "6080": {
      "label": "IBKR Paper Browser",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup_ibkr_paper.sh",
  "postStartCommand": "bash .devcontainer/start_ibkr_paper.sh && bash .devcontainer/start_phone_browser.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
