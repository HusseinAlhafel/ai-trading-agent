{
  "name": "AI Trading Agent + IBKR Paper",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "11"
    }
  },
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "IBKR Paper Client Portal",
      "protocol": "https",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup_ibkr_paper.sh",
  "postStartCommand": "bash .devcontainer/start_ibkr_paper.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
