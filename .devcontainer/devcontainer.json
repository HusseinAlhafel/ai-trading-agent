{
  "name": "AI Trading Agent + IBKR Paper",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "11"
    },
    "ghcr.io/devcontainers/features/desktop-lite:1.2.10": {
      "password": "vscode",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "runArgs": ["--shm-size=1g", "--init"],
  "forwardPorts": [5000, 6080],
  "portsAttributes": {
    "5000": {
      "label": "IBKR Paper Client Portal",
      "protocol": "https"
    },
    "6080": {
      "label": "IBKR Paper Browser",
      "protocol": "http"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends firefox-esr && bash .devcontainer/setup_ibkr_paper.sh",
  "postStartCommand": "bash .devcontainer/start_ibkr_paper.sh && (export DISPLAY=:1; nohup firefox-esr --no-remote --new-instance https://localhost:5000/ > ${HOME}/ibkr-clientportal/firefox.log 2>&1 &)",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
