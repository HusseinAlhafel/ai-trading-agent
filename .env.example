# PAPER TRADING ONLY. No live trading is implemented in this build.
TRADING_MODE=PAPER

# IBKR paper-session settings for the future TWS/IB Gateway integration.
# These are configuration placeholders only; this project does not connect yet.
IBKR_PAPER_HOST=127.0.0.1
IBKR_PAPER_PORT=7497
IBKR_PAPER_CLIENT_ID=7

# Local/offline paper simulator defaults.
STARTING_CASH=10000
SYMBOL=DEMO
POSITION_SIZE=0.20
MAX_POSITION=1.00
FEE_RATE=0.001

# Legacy Plus500 signal-only flags. Keep disabled.
PLUS500_T4_ENABLED=false
PLUS500_T4_LIVE_TRADING=false
PLUS500_T4_HOST=
PLUS500_T4_PORT=0
PLUS500_T4_ACCOUNT=
